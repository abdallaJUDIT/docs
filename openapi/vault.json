{
  "openapi": "3.0.3",
  "info": {
    "title": "JUDIT - Credentials Vault API",
    "description": "OpenAPI description for the credentials vault routes: register, inspect and delete per-tribunal credentials (username/password, 2FA secret or A1 certificate).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://crawler.prod.judit.io",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Credentials",
      "description": "Register and inspect tribunal system credentials stored in the vault"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/credentials": {
      "get": {
        "tags": [
          "Credentials"
        ],
        "summary": "List credential status by system",
        "description": "Returns the credential status of each tribunal system. Without `customer_key`, lists every system available in the vault (use it to copy the exact `system_name`). With `customer_key`, lists only the systems that have a credential for that key, plus the wildcard (`*`) row. `inactive` means the credential failed to log in to the court (invalid/expired password, blocked user or expired certificate); re-register it to make it `active` again.",
        "operationId": "getCredentials",
        "responses": {
          "200": {
            "description": "List of systems with their credential status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "systems": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Tribunal system name, or `*` for the wildcard credential"
                          },
                          "customer_key": {
                            "type": "string",
                            "description": "Key used as the filter (default `*`). In the `*` row it is empty when no wildcard credential exists for that key; the other rows repeat the filter key even when the status is `not exists`."
                          },
                          "credential_status": {
                            "type": "string",
                            "enum": [
                              "not exists",
                              "active",
                              "inactive"
                            ],
                            "description": "`active`: available. `inactive`: failed to log in to the court. `not exists`: no credential registered."
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "systems": [
                    {
                      "name": "*",
                      "customer_key": "",
                      "credential_status": "not exists"
                    },
                    {
                      "name": "PJE TJBA - 1º grau",
                      "customer_key": "*",
                      "credential_status": "not exists"
                    }
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "customer_key",
            "in": "query",
            "required": false,
            "description": "Credential key defined at registration. Defaults to `*`.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Credentials"
        ],
        "summary": "Register or update password credentials",
        "description": "Registers username/password credentials (optionally with a 2FA authenticator secret) for one or more tribunal systems. Sending the same `system_name` + `customer_key` replaces the existing credential, including `custom_data`. With a valid body (the `credentials` list) it returns HTTP 200 even when an item is not registered: check the `message` of each item. An invalid body returns HTTP 400. Digital certificates are not accepted here: a `file_base64` field is silently ignored; use `POST /credentials/certificate`.",
        "operationId": "postCredentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "credentials"
                ],
                "properties": {
                  "credentials": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "system_name",
                        "username",
                        "password"
                      ],
                      "properties": {
                        "system_name": {
                          "type": "string",
                          "description": "System name exactly as listed by `GET /credentials` (e.g. \"PJE TJBA - 1º grau\"), or `*` for the wildcard credential."
                        },
                        "customer_key": {
                          "type": "string",
                          "description": "Client-defined identifier for the credential. Defaults to `*`."
                        },
                        "username": {
                          "type": "string",
                          "description": "Court portal login (CPF or OAB, as the court requires)."
                        },
                        "password": {
                          "type": "string",
                          "description": "Court portal password."
                        },
                        "custom_data": {
                          "type": "object",
                          "description": "Extra credential data. Only for courts that ask for an authenticator app code.",
                          "properties": {
                            "secret": {
                              "type": "string",
                              "description": "2FA secret: the fixed authenticator setup key (never the temporary 6-digit code). Judit generates the code at each login."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "credentials": [
                  {
                    "system_name": "PJE TJBA - 1º grau",
                    "customer_key": "advogado_01",
                    "username": "999.999.999-99",
                    "password": "<senha-do-tribunal>",
                    "custom_data": {
                      "secret": "JBSWY3DPEHPK3PXP"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One result per item sent (order may differ). Errors are reported per item in `message`, still with HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "system_name": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string",
                        "enum": [
                          "CREDENTIAL_CREATED",
                          "CREDENTIAL_UPDATED",
                          "SYSTEM_NAME_NOT_FOUND",
                          "USERNAME_NOT_FOUND",
                          "PASSWORD_NOT_FOUND",
                          "USERNAME_AND_PASSWORD_NOT_FOUND",
                          "CERTIFICATE_FIELDS_NOT_ALLOWED"
                        ]
                      }
                    }
                  }
                },
                "example": [
                  {
                    "system_name": "PJE TJBA - 1º grau",
                    "message": "CREDENTIAL_CREATED"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Body is not a valid `credentials` array.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Credentials"
        ],
        "summary": "Delete a credential",
        "operationId": "deleteCredential",
        "description": "Deletes the credential of a system for a `customer_key`. To delete the wildcard credential or a certificate, use `system_name: \"*\"`. A stored certificate is deleted together with the credential.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "system_name"
                ],
                "properties": {
                  "system_name": {
                    "type": "string",
                    "description": "System name as registered, or `*`."
                  },
                  "customer_key": {
                    "type": "string",
                    "description": "Credential key. Defaults to `*`."
                  }
                }
              },
              "example": {
                "system_name": "PROJUDI TJGO - 1º grau",
                "customer_key": "advogado_01"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credential deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`SOURCE_NOT_FOUND` (unknown system) or `CREDENTIAL_NOT_FOUND`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/credentials/certificate": {
      "post": {
        "tags": [
          "Credentials"
        ],
        "summary": "Register or update a digital certificate credential",
        "description": "Uploads an A1 digital certificate (PKCS#12 `.pfx` / `.p12`, max 64 KB). The certificate is always stored as the wildcard (`*`) credential of the given `customer_key`, so it applies to every system without a specific credential for that key. This is the only route that accepts certificates. Other fields (`system_name`, `totp_secret`, `custom_data`) are silently ignored. If the court also asks for an authenticator app code, contact Judit support.",
        "operationId": "postCredentialsCertificate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "file_base64",
                  "password"
                ],
                "properties": {
                  "file_base64": {
                    "type": "string",
                    "description": "PFX/P12 file content encoded as a single-line Base64 string"
                  },
                  "password": {
                    "type": "string",
                    "description": "Password of the PKCS#12 file (not the court portal password)"
                  },
                  "customer_key": {
                    "type": "string",
                    "description": "Client-defined identifier for the credential. Defaults to `*`"
                  }
                }
              },
              "example": {
                "customer_key": "advogado_01",
                "file_base64": "MIIK...",
                "password": "<senha-do-arquivo-pfx>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Certificate created or updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "enum": [
                        "CERTIFICATE_CREATED",
                        "CERTIFICATE_UPDATED"
                      ]
                    },
                    "customer_key": {
                      "type": "string"
                    },
                    "subject_cn": {
                      "type": "string",
                      "description": "Certificate holder (CN)"
                    },
                    "not_after": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Certificate expiration date"
                    },
                    "uploaded_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "message": "CERTIFICATE_CREATED",
                  "customer_key": "advogado_01",
                  "subject_cn": "NOME DO TITULAR:12345678909",
                  "not_after": "2027-01-01T00:00:00.000Z",
                  "uploaded_at": "2026-07-31T17:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Invalid certificate file. Possible codes: `PFX_MALFORMED`, `PFX_PASSWORD_INVALID`, `PFX_NO_PRIVATE_KEY`, `PFX_NO_CERTIFICATE`, `PFX_EXPIRED`, `PFX_NOT_YET_VALID`, `PFX_TOO_LARGE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict. Possible codes: `CERTIFICATE_HOLDER_MISMATCH` (a certificate from another holder is already registered for this key), `CREDENTIAL_TYPE_CONFLICT` (a wildcard username/password credential already exists for this key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "api-key",
        "description": "API key for authentication"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Error envelope. The specific error code is in `data`.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "HttpBadRequestError"
              },
              "message": {
                "type": "string",
                "example": "BAD_REQUEST"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "PFX_PASSWORD_INVALID"
                ]
              }
            }
          }
        }
      }
    }
  }
}
