              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"search\": {\n        \"search_type\": \"cpf\",\n        \"search_key\": \"{{cpf}}\",\n        \"search_params\": {\n            \"filter\": {\n                \"side\": \"Passive\",\n                \"tribunals\": {\n                    \"keys\": [\"TJRJ\"],\n                    \"not_equal\": false\n                },\n                \"subject_codes\": {\n                    \"contains\": [\"10433\", \"10557\"],\n                    \"not_contains\": [\"10433\"]\n                },\n                \"classification_codes\": {\n                    \"keys\": [\"985\", \"746\"],\n                    \"not_equal\": false\n                },\n                \"distribution_date_gte\": \"2023-10-10T00:00:00.000Z\",\n                \"last_step_date_gte\": \"2024-10-10T00:00:00.000Z\",\n                \"party_names\": [\"USUÁRIO TESTE\"],\n                \"party_documents\": [\"{{cpf}}\"]\n            }\n        }\n    }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url_requests}}/requests",
              "host": [
                "{{base_url_requests}}"
              ],
              "path": [
                "requests"
              ]
            },
            "description": "Cria uma requisição para buscar processos por documento (CPF neste exemplo) com filtros de polo, tribunal, assunto, classificação, data, nome e documento de parte."
          },
          "response": []
        },
        {
          "name": "2 - Consultar status da requisição",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_requests}}/requests/{{request_id}}",
              "host": [
                "{{base_url_requests}}"
              ],
              "path": [
                "requests",
                "{{request_id}}"
              ]
            },
            "description": "Retorna o status atual de uma requisição. Usa `{{request_id}}` (preenchido automaticamente pelo passo 1)."
          },
          "response": []
        },
        {
          "name": "3 - Listar respostas da requisição",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_requests}}/responses?page_size=100&request_id={{request_id}}",
              "host": [
                "{{base_url_requests}}"
              ],
              "path": [
                "responses"
              ],
              "query": [
                {
                  "key": "page_size",
                  "value": "100"
                },
                {
                  "key": "request_id",
                  "value": "{{request_id}}"
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "response_type",
                  "value": "lawsuit",
                  "disabled": true
                }
              ]
            },
            "description": "Lista todas as respostas geradas pela requisição. Habilite `page` para paginar ou `response_type` para filtrar pelo formato."
          },
          "response": []
        },
        {
          "name": "4 - Baixar anexo do processo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_lawsuits}}/lawsuits/{{cnj_code}}/{{lawsuit_instance}}/attachments/{{attachment_id}}",
              "host": [
                "{{base_url_lawsuits}}"
              ],
              "path": [
                "lawsuits",
                "{{cnj_code}}",
                "{{lawsuit_instance}}",
                "attachments",
                "{{attachment_id}}"
              ]
            },
            "description": "Baixa um anexo do processo como stream binário. Defina `attachment_id` a partir da resposta do processo (`attachments[].id`)."
          },
          "response": []
        }
      ],
      "description": "Fluxo ponta a ponta: cria uma requisição por CNJ ou por documento (CPF, CNPJ, OAB, nome), consulta o status, busca a resposta e baixa anexos.\n\n**Ordem dos passos**: 1 → 2 → 3 → 4. Executar o passo 1 já salva o `request_id` retornado em uma variável da coleção, então os passos 2 e 3 funcionam sem copiar e colar."
    },
